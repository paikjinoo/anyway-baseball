rules_version = '2';

// Anyway Baseball — Firestore 보안 규칙
//
// 설계 원칙
//  - 팀/리그는 소유자만 쓸 수 있다.
//  - 방(rooms)은 로그인한 사용자면 읽을 수 있고, 방장만 만들 수 있다.
//    입장하는 게스트는 answer/status만 갱신할 수 있다.
//  - 경기 데이터는 Firestore를 거치지 않고 WebRTC DataChannel로만 오간다.
//    따라서 여기에는 게임 상태를 저장하는 컬렉션이 없다.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ---- 팀 -----------------------------------------------------------
    //
    // 한 번의 쓰기로 골드가 늘 수 있는 상한. 정상 경로의 최댓값은 능력치초기화권의 구종
    // 골드 환급(3만G 남짓)이고, 그다음이 최대 레벨 S 방출(18,880G)과 리그 우승(8,000G)이다.
    //
    // **이 게임에서 서버가 실제로 강제하는 규칙은 이것 하나뿐이다.** 판정이 전부
    // 클라이언트에 있어 "이 골드를 정말 벌었는가"는 여기서 알 수 없고, 알 수 있는 것은
    // "한 번에 이만큼 느는 일은 정상 플레이에 없다"뿐이다. 콘솔로 30만G를 넣고 새로고침하는
    // 조작은 이 선에서 원격 문서까지 오염되는 것을 막는다 — 서명(src/lib/game/integrity.ts)이
    // 로컬을 되돌리는 동안, 원격에는 애초에 그 값이 올라가지 못한다.
    //
    // 한계도 분명하다. 삭제 후 재생성은 이 검사를 지나지 않는다(create에는 비교할 이전 값이
    // 없다). 백업 가져오기가 정확히 그 경로라 막을 수도 없다.
    //
    // **src/lib/game/integrity.MAX_GOLD_GAIN_PER_SAVE와 같은 값이어야 한다.**
    function goldGainOk() {
      return request.resource.data.gold is number
        && request.resource.data.gold >= 0
        && request.resource.data.gold <= resource.data.gold + 50000;
    }

    match /teams/{teamId} {
      // 온라인 대전에서 상대 팀 정보를 봐야 하므로 읽기는 열어 둔다.
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid && goldGainOk();
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // ---- 리그 ---------------------------------------------------------
    match /leagues/{leagueId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // ---- 감독 프로필 (닉네임) --------------------------------------------
    // 문서 id가 곧 uid다. 본인만 쓰고, 기기를 옮겨도 같은 닉네임을 쓰기 위해 존재한다.
    match /profiles/{profileUid} {
      allow read: if signedIn();
      allow write: if signedIn() && profileUid == request.auth.uid;
    }

    // ---- 방 (WebRTC 시그널링 전용) ---------------------------------------
    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.hostUid == request.auth.uid;

      // 방장은 무엇이든 수정/삭제할 수 있다.
      // 게스트는 answer와 status만 쓸 수 있다 (offer/hostUid 변조 방지).
      allow update: if signedIn() && (
        resource.data.hostUid == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['answer', 'status'])
      );
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;

      // ICE 후보. 연결이 끝나면 클라이언트가 정리한다.
      match /hostCandidates/{doc} {
        allow read, create, delete: if signedIn();
      }
      match /guestCandidates/{doc} {
        allow read, create, delete: if signedIn();
      }

      // ---- 2대2 시그널링 -------------------------------------------------
      // 게스트가 3명이라 방 문서의 offer/answer 한 쌍으로는 부족하다.
      // 게스트마다 문서를 하나씩 만들고, 게스트가 offer를 / 방장이 answer를 쓴다.
      function isRoomHost(roomId) {
        return get(/databases/$(database)/documents/rooms/$(roomId)).data.hostUid == request.auth.uid;
      }

      match /peers/{peerUid} {
        allow read: if signedIn();
        // 자기 자리는 자기가 만든다
        allow create: if signedIn() && peerUid == request.auth.uid;
        // 게스트는 자기 문서를, 방장은 answer를 쓴다.
        // 방을 닫을 때 방장이 남은 자리를 정리하므로 삭제도 방장에게 열어 둔다.
        allow update, delete: if signedIn() && (
          peerUid == request.auth.uid || isRoomHost(roomId)
        );

        match /hostCandidates/{doc} {
          allow read, create, delete: if signedIn();
        }
        match /guestCandidates/{doc} {
          allow read, create, delete: if signedIn();
        }
      }
    }
  }
}
